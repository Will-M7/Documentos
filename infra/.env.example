# Copie este archivo como .env (en esta misma carpeta) y cambie TODOS los valores.
# El archivo .env nunca se sube al repositorio.

# --- Base de datos ---
DB_NOMBRE=estudio_documental
DB_USUARIO=estudio
DB_CLAVE=cambie-esta-clave

# --- Seguridad ---
# Mínimo 32 caracteres al azar. Por ejemplo, en PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRETO=cambie-por-una-clave-larga-y-aleatoria-de-32-o-mas
DURACION_TOKEN=8h

# --- Primer administrador (solo se crea si no hay usuarios) ---
ADMIN_USUARIO=admin
ADMIN_CLAVE=cambie-esta-clave-inicial
ADMIN_NOMBRE=Administrador

# --- Red ---
PUERTO_WEB=8080
